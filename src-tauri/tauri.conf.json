{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scrooge",
  "version": "../package.json",
  "identifier": "dev.scrooge.widget",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Scrooge",
        "width": 400,
        "height": 600,
        "minWidth": 300,
        "minHeight": 200,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "The Scrooge contributors",
    "copyright": "Copyright (c) 2026 The Scrooge contributors. MIT License.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "licenses/Scrooge.txt",
      "../crates/abtop/LICENSE": "licenses/abtop.txt",
      "../NOTICE.md": "licenses/NOTICE.md",
      "../vendor/glib-0.18.5/LICENSE": "licenses/glib-LICENSE",
      "../vendor/glib-0.18.5/COPYRIGHT": "licenses/glib-COPYRIGHT"
    },
    "category": "DeveloperTool",
    "shortDescription": "Desktop monitor for AI coding agents",
    "longDescription": "Scrooge shows every AI coding agent running on your machine (Claude Code, Codex CLI, OpenCode, GitHub Copilot, Gemini CLI, Grok Build): sessions, read/written/cached tokens, context windows and quotas, in a compact panel or a full-screen dashboard.",
    "homepage": "https://github.com/DraconDeSo/scrooge",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxNDk0RDdENTdCM0U1MzcKUldRMzViTlhmVTFKZ2FVUkxSbGpBMzU5bDhlQXpBSXozRnJYZ0Voall3UWE4VVlkYXdQRDZXQTQK",
      "endpoints": [
        "https://github.com/DraconDeSo/scrooge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
